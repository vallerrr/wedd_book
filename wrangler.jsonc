{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wedd-book",
  "compatibility_date": "2026-08-01",

  // Static SPA. There is no Worker script — Cloudflare just serves ./dist and
  // falls back to index.html so deep links like /program and /admin resolve
  // client-side instead of 404ing.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },

  // Guests reach the app here, not on workers.dev — that whole zone is
  // blocked in mainland China, which we confirmed the hard way. Recorded as a
  // route so the binding is reproducible rather than dashboard-only.
  "routes": [{ "pattern": "yanzberg.cc", "custom_domain": true }]

  // No runtime vars here on purpose. VITE_SUPABASE_* are inlined by Vite at
  // BUILD time, so they belong in the build environment (Cloudflare's
  // "Variables and secrets", or .env.local locally) — never in the deployed
  // Worker, which only serves files.
}
